# Adresse publique du backend (API). Sans barre finale.
# Développement : http://localhost:5500
# Production    : l'adresse HTTPS de votre API, par ex. https://api.exemple.com
# Variable figée au build : rebâtissez le site après l'avoir modifiée.
NEXT_PUBLIC_API_URL=http://localhost:5500

# Adresse publique du site, pour le référencement (liens canoniques, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vérification de propriété (Google Search Console / Bing Webmaster) : valeur du jeton « balise HTML ».
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
