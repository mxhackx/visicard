generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model VisitingCard {
  id             BigInt   @id @default(autoincrement())
  slug           String   @unique
  imageUrl       String   @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")
}

model Card {
  id             BigInt   @id @default(autoincrement())
  slug           String   @unique
  imageUrl       String   @map("image_url")
  ownerId        String?  @map("owner_id")
  /// `page` (page digitale), `media` (image / vidéo) ou `document` (PDF).
  serviceType    String   @default("page") @map("service_type")
  title          String?
  contentUrl     String?  @map("content_url")
  contentType    String?  @map("content_type")
  fileName       String?  @map("file_name")
  userName       String?  @map("user_name")
  clientName     String?  @map("client_name")
  workDone       String?  @map("work_done")
  amountReceived Float?   @map("amount_received")
  currency       String?  @default("fcfa") @map("currency")
  restaurantName String?  @map("restaurant_name")
  address        String?  @map("address")
  logoUrl        String?  @map("logo_url")
  locationUrl    String?  @map("location_url")
  phoneNumber    String?  @map("phone_number")
  menuImages     String?  @map("menu_images")
  placeImages    String?  @map("place_images")
  facebookUrl    String?  @map("facebook_url")
  instagramUrl   String?  @map("instagram_url")
  xUrl           String?  @map("x_url")
  snapchatUrl    String?  @map("snapchat_url")
  schedule       Json?    @map("schedule")
  additionalInfo String?  @map("additional_info")
  cardLayout     String?  @default("classic") @map("card_layout")
  themeId        String?  @default("theme-1") @map("theme_id")
  qrStyle        String?  @default("style-1") @map("qr_style")
  /// `draft` : aperçu, non payé (page publique et téléchargement bloqués).
  /// `active` : payé, ou créé par un administrateur.
  /// `rejected` : refusé par un administrateur (contenu non conforme) ; motif dans `moderationNote`.
  status         String   @default("active")
  moderationNote String?  @map("moderation_note")
  rejectedAt     DateTime? @map("rejected_at")
  /// Colonnes déjà présentes en base (déclarées pour ne pas être supprimées par db push).
  isActive       Boolean  @default(true) @map("is_active")
  updatedAt      DateTime @default(now()) @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  owner          AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  orders         Order[]
  scans          CardScan[]

  @@map("cards")
}

/// Commande d'un client sans compte : un devis, puis une facture une fois payée.
/// `kind` = `creation` (nouveau QR code) ou `modification` (changement de contenu,
/// appliqué à la carte seulement après paiement, depuis `pendingChanges`).
model Order {
  id              String    @id @default(uuid())
  reference       String    @unique
  kind            String    @default("creation")
  serviceType     String    @map("service_type")
  /// `quote` (devis émis), `pending` (paiement en cours), `paid`, `cancelled`.
  status          String    @default("quote")
  items           Json
  amount          Int
  currency        String    @default("XOF")
  customerName    String    @map("customer_name")
  customerPhone   String    @map("customer_phone")
  customerEmail   String?   @map("customer_email")
  /// Compte client propriétaire (obligatoire pour page, image, vidéo, PDF ; facultatif pour un QR direct).
  userId          String?   @map("user_id")
  /// Empreinte SHA-256 du jeton du lien privé : le jeton lui-même n'est jamais stocké.
  accessTokenHash String    @map("access_token_hash")
  quoteNumber     String    @unique @map("quote_number")
  invoiceNumber   String?   @unique @map("invoice_number")
  pendingChanges  Json?     @map("pending_changes")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  cardId          BigInt    @map("card_id")
  card            Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  parentId        String?   @map("parent_id")
  payments        Payment[]

  @@index([cardId])
  @@index([userId])
  @@map("orders")
}

/// Paiement enregistré sur une commande. Aujourd'hui `manuel` (réglé sur WhatsApp,
/// confirmé par un administrateur) ; `fedapay`, `momo` et `simulation` restent dans l'historique.
model Payment {
  id          String   @id @default(uuid())
  provider    String
  /// Identifiant unique du paiement (`man-…` pour un encaissement manuel).
  providerRef String   @map("provider_ref")
  /// `pending`, `succeeded`, `failed`.
  status      String   @default("pending")
  amount      Int
  currency    String
  phone       String?
  raw         Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

/// Compteurs de numérotation continue (devis, factures), un par clé et par année.
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

/// Compte administrateur servi par la base elle-même, et non par Supabase Auth.
/// Le mot de passe en clair n'est jamais stocké : seulement `passwordHash`, un
/// scrypt (voir src/auth/mot-de-passe.ts). La ligne se crée avec `npm run seed`,
/// qui lit ADMIN_EMAIL et ADMIN_PASSWORD depuis l'environnement.
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cards        Card[]
  apiKeys      ApiKey[]

  @@map("admin_users")
}

/// Scans enregistrés par carte (table déjà présente en base).
model CardScan {
  id        BigInt   @id @default(autoincrement())
  cardId    BigInt   @map("card_id")
  device    String   @default("other")
  createdAt DateTime @default(now()) @map("created_at")
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@map("card_scans")
}

/// Clé d'API développeur. La clé en clair n'est jamais stockée : seulement son empreinte SHA-256.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  /// Début de la clé (non secret), pour la reconnaître dans la liste.
  prefix     String
  keyHash    String    @unique @map("key_hash")
  /// Requêtes autorisées par minute et par mois (ignorées pour un compte administrateur).
  perMinute  Int       @default(30) @map("per_minute")
  perMonth   Int       @default(1000) @map("per_month")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage      ApiUsage[]

  @@index([userId])
  @@map("api_keys")
}

/// Compteur mensuel d'appels par clé (période « AAAA-MM », UTC).
model ApiUsage {
  id     BigInt @id @default(autoincrement())
  keyId  String @map("key_id")
  period String
  count  Int    @default(0)

  key    ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, period])
  @@map("api_usage")
}
