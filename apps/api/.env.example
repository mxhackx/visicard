# Copier ce fichier en .env (il est ignoré par git) puis renseigner les valeurs.
# Aucune de ces lignes n'a de valeur par défaut sensée en production.

# --- Base de données -------------------------------------------------------
# Un utilisateur `moncode` créé par la base locale, avec un mot de passe choisi
# par vous. DATABASE_URL sert aux requêtes, DIRECT_URL aux opérations Prisma
# qui ont besoin d'une connexion directe (les deux peuvent être identiques ici).
DATABASE_URL="postgresql://moncode:MOT_DE_PASSE_BASE@127.0.0.1:5432/moncode?schema=public"
DIRECT_URL="postgresql://moncode:MOT_DE_PASSE_BASE@127.0.0.1:5432/moncode?schema=public"

# --- API -------------------------------------------------------------------
PORT=5500
# Adresse publique du SITE (front) : liens des QR codes, CORS, redirections.
# Production : https://votre-site.com (sans barre finale).
APP_URL=http://localhost:3000
# Adresse publique de CETTE API : URL des fichiers envoyés (/uploads/...).
# Production : https://api.votre-site.com
API_URL=http://localhost:5500

# Signature des jetons de session locaux (HS256). À produire avec :
#   openssl rand -hex 32
# Sans lui, l'API génère une clé éphémère et les sessions tombent à chaque
# redémarrage.
AUTH_SECRET=

# --- Compte administrateur (table admin_users) -----------------------------
# Lus uniquement par `npm run seed`. ADMIN_PASSWORD ne doit jamais être écrit
# en clair dans le dépôt ni dans un ticket : seul son hachage scrypt est stocké.
ADMIN_EMAIL=mxhackx@gmail.com
ADMIN_PASSWORD=

# --- Compte intervenant (facultatif) ---------------------------------------
USER_EMAIL=user@moncode.com

# --- Supabase (chemin d'origine, facultatif hors connexion) ----------------
# Laissez vide pour que l'API n'utilise que les comptes de la base.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cards

# --- Paiements ---------------------------------------------------------------
# FeexPay : paiement Mobile Money (MTN, Moov, Celtiis), dans un formulaire du site : le client valide sur son téléphone.
# Tableau de bord FeexPay > Développeurs : clé privée (`test_key_…` en sandbox, `fp_…` en production) et identifiant public de la boutique.
FEEXPAY_ENV=sandbox
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
# Webhooks (FeexPay > Webhooks) : l'URL à déclarer est https://<votre-api>/payments/feexpay/webhook ;
# FEEXPAY_WEBHOOK_SECRET est la valeur de l'en-tête « Authorization » choisie là-bas (schéma Bearer par défaut, ou Basic).
FEEXPAY_WEBHOOK_SECRET=
# FEEXPAY_WEBHOOK_SCHEME=Bearer

# Notifications de demandes (réservations, commandes, messages) : e-mail au propriétaire via Resend.
# Facultatif : sans clé, les demandes restent visibles dans l'espace client.
RESEND_API_KEY=
MAIL_FROM=Moncode <notifications@moncode.app>

# Connexion avec Google (facultatif) : « ID client » OAuth créé dans Google Cloud Console.
# Le même identifiant est à mettre côté site dans NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- Réglages locaux : copiez ces lignes dans `.env.render` (le fichier chargé par l’API) ---
# FEEXPAY_ENV=sandbox
# FEEXPAY_API_KEY=test_key_...
# FEEXPAY_SHOP_ID=...
# FEEXPAY_WEBHOOK_SECRET=...
# APP_URL=http://localhost:3000
# API_URL=http://localhost:5500
CORS_ORIGINS=

# Formulaire de contact : adresse qui reçoit les messages (par défaut ADMIN_EMAIL). Avec Resend en test, l'adresse du propriétaire du compte Resend.
CONTACT_TO=
